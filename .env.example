# Copy this file to .env.local and adjust the values if needed.

# Base URL of the app in the current environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development database (started with `docker compose up -d`).
# Production uses a Neon connection string configured in Vercel.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinic_booking

# Secret used to sign session cookies. Any long random string works locally.
AUTH_SECRET=local-development-secret-change-me
